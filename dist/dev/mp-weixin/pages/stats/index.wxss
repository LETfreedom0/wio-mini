
.container.data-v-1fa681a1 {
  min-height: 100vh;
  background-color: #F2F4F6;
  padding: 20px;
  box-sizing: border-box;
  padding-bottom: calc(40px + env(safe-area-inset-bottom));
}

/* ---- 页头 ---- */
.page-head.data-v-1fa681a1 {
  display: flex;
  align-items: center;
  margin-bottom: 14px;
}
.back-btn.data-v-1fa681a1 {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-text.data-v-1fa681a1 {
  font-size: 22px;
  color: #151820;
  line-height: 1;
}
.page-title.data-v-1fa681a1 {
  font-size: 18px;
  font-weight: bold;
  color: #151820;
  flex: 1;
}
.head-space.data-v-1fa681a1 { width: 28px;
}

/* ---- 卡片通用 ---- */
.card.data-v-1fa681a1 {
  background-color: #FFFFFF;
  border-radius: 18px;
  padding: 16px;
  margin-bottom: 14px;
}
.section-title.data-v-1fa681a1 {
  font-size: 13px;
  font-weight: 600;
  color: #151820;
}
.section-sub.data-v-1fa681a1 {
  font-size: 10.5px;
  color: #8A94A0;
  margin-top: 3px;
}

/* ---- 锁定态 ---- */
.locked-card.data-v-1fa681a1 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 24px;
}
.locked-icon.data-v-1fa681a1 { font-size: 40px;
}
.locked-title.data-v-1fa681a1 {
  font-size: 16px;
  font-weight: 600;
  color: #151820;
  margin-top: 12px;
}
.locked-sub.data-v-1fa681a1 {
  font-size: 12px;
  color: #8A94A0;
  text-align: center;
  margin-top: 6px;
  line-height: 1.6;
}
.locked-cta.data-v-1fa681a1 {
  margin-top: 20px;
  background-color: #C08A2D;
  border-radius: 999px;
  padding: 10px 32px;
}
.locked-cta-text.data-v-1fa681a1 { color: #FFFFFF; font-size: 14px; font-weight: 600;
}

/* ---- 概览卡 ---- */
.year-row.data-v-1fa681a1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.year-text.data-v-1fa681a1 { font-size: 13px; color: #6B737B;
}
.year-switch.data-v-1fa681a1 { display: flex; align-items: center;
}
.year-arrow.data-v-1fa681a1 {
  font-size: 18px;
  color: #6B737B;
  padding: 2px 8px;
}
.year-arrow.disabled.data-v-1fa681a1 { color: #C3C9CE;
}
.num-row.data-v-1fa681a1 {
  display: flex;
  align-items: flex-end;
  margin-top: 8px;
}
.num-big.data-v-1fa681a1 {
  font-size: 34px;
  font-weight: bold;
  color: #151820;
  line-height: 1.1;
}
.num-denom.data-v-1fa681a1 {
  font-size: 14px;
  color: #8A94A0;
  margin-left: 6px;
  margin-bottom: 3px;
}
.ratio-text.data-v-1fa681a1 {
  font-size: 11px;
  color: #8A8F98;
  margin-top: 6px;
}
.progress-track.data-v-1fa681a1 {
  height: 6px;
  background-color: #E7EBED;
  border-radius: 3px;
  margin-top: 10px;
  overflow: hidden;
}
.progress-fill.data-v-1fa681a1 {
  height: 6px;
  background-color: #0E6E62;
  border-radius: 3px;
}
.stat-divider.data-v-1fa681a1 {
  height: 1px;
  background-color: #F0EDE6;
  margin-top: 14px;
}
.stat-row.data-v-1fa681a1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14px;
}
.stat-label-group.data-v-1fa681a1 { display: flex; flex-direction: column;
}
.stat-label.data-v-1fa681a1 { font-size: 11.5px; color: #6B737B;
}
.stat-est.data-v-1fa681a1 { font-size: 10.5px; color: #8A94A0; margin-top: 3px;
}
.stat-value-group.data-v-1fa681a1 {
  display: flex;
  align-items: center;
}
.stat-value.data-v-1fa681a1 { font-size: 11.5px; font-weight: 500; color: #0E6E62;
}
.stat-conv.data-v-1fa681a1 { font-size: 11.5px; color: #8A94A0; margin-left: 4px;
}

/* ---- 趋势卡 ---- */
.trend-card .section-sub.data-v-1fa681a1 { display: block;
}
.chart.data-v-1fa681a1 { margin-top: 14px;
}
.chart-area.data-v-1fa681a1 {
  display: flex;
  align-items: flex-end;
  height: 116px;
  position: relative;
}
.chart-col.data-v-1fa681a1 {
  flex: 1;
  height: 116px;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar.data-v-1fa681a1 {
  width: 55%;
  background-color: #0E6E62;
  border-radius: 3px 3px 0 0;
  min-height: 0;
}
.bar-current.data-v-1fa681a1 { background-color: #C08A2D;
}
.bar-selected.data-v-1fa681a1 { background-color: #0B5248;
}
/* 点选柱子时弹出的天数气泡 */
.bar-tip.data-v-1fa681a1 {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  background-color: #151820;
  border-radius: 4px;
  padding: 2px 6px;
  white-space: nowrap;
  z-index: 2;
}
.bar-tip-text.data-v-1fa681a1 {
  color: #FFFFFF;
  font-size: 10px;
  line-height: 1.4;
}
.chart-baseline.data-v-1fa681a1 {
  height: 1px;
  background-color: #E7EBED;
}
.month-labels.data-v-1fa681a1 {
  display: flex;
  margin-top: 6px;
}
.month-label.data-v-1fa681a1 {
  flex: 1;
  text-align: center;
  font-size: 9.5px;
  color: #8A94A0;
}
.month-label.active.data-v-1fa681a1 {
  color: #151820;
  font-weight: 600;
}
.legend.data-v-1fa681a1 {
  display: flex;
  gap: 12px;
  margin-top: 10px;
}
.legend-item.data-v-1fa681a1 {
  display: flex;
  align-items: center;
  gap: 5px;
}
.legend-dot.data-v-1fa681a1 { width: 8px; height: 8px; border-radius: 2px;
}
.legend-dot-green.data-v-1fa681a1 { background-color: #0E6E62;
}
.legend-dot-gold.data-v-1fa681a1 { background-color: #C08A2D;
}
.legend-text.data-v-1fa681a1 { font-size: 10.5px; color: #6B737B;
}

/* ---- 假期卡 ---- */
.leave-row.data-v-1fa681a1 {
  display: flex;
  align-items: center;
  margin-top: 14px;
}
.leave-name.data-v-1fa681a1 {
  width: 44px;
  font-size: 11.5px;
  color: #6B737B;
  flex-shrink: 0;
}
.leave-track.data-v-1fa681a1 {
  flex: 1;
  height: 6px;
  background-color: #E7EBED;
  border-radius: 3px;
  margin: 0 12px;
  overflow: hidden;
}
.leave-fill.data-v-1fa681a1 {
  height: 6px;
  background-color: #0E6E62;
  border-radius: 3px;
}
.leave-fill-gold.data-v-1fa681a1 { background-color: #C08A2D;
}
.leave-num.data-v-1fa681a1 {
  font-size: 10.5px;
  color: #8A8F98;
  flex-shrink: 0;
  min-width: 44px;
  text-align: right;
}

/* ---- 通勤编辑弹层 ---- */
.editor-mask.data-v-1fa681a1 {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.editor-sheet.data-v-1fa681a1 {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 20px 20px 0 0;
  padding: 24px 20px calc(24px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.editor-title.data-v-1fa681a1 { font-size: 14px; font-weight: 600; color: #151820;
}
.editor-value.data-v-1fa681a1 {
  display: block;
  font-size: 28px;
  font-weight: bold;
  color: #0E6E62;
  margin-top: 12px;
}
.editor-slider.data-v-1fa681a1 { margin: 20px 4px 4px;
}
.editor-ticks.data-v-1fa681a1 {
  display: flex;
  justify-content: space-between;
  margin: 0 4px;
}
.editor-tick.data-v-1fa681a1 { font-size: 10px; color: #8A94A0;
}
.editor-save.data-v-1fa681a1 {
  margin-top: 20px;
  background-color: #0E6E62;
  border-radius: 999px;
  padding: 12px;
  display: flex;
  justify-content: center;
}
.editor-save-text.data-v-1fa681a1 { color: #FFFFFF; font-size: 14px; font-weight: 600;
}
