/* Today Highlight Style */
.today-highlight.data-v-3ceb4997 {
  position: relative;
  font-weight: bold;
}

/* Add a blue dot indicator for Today */
.today-highlight.data-v-3ceb4997::after {
  content: '';
  position: absolute;
  bottom: 2px;
  width: 4px;
  height: 4px;
  background-color: #1976D2;
  border-radius: 50%;
}

/* If no status background, give today a subtle blue background */
.today-highlight.data-v-3ceb4997:not(.company-office):not(.home-office):not(.status-vacation):not(.status-comp-off):not(.status-sick):not(.status-unpaid):not(.status-public) {
  background-color: #E3F2FD;
  color: #1976D2;
  border: 1px solid #1976D2;
}

/* If it HAS a status background, add a blue border to indicate today */
.today-highlight.company-office.data-v-3ceb4997,
.today-highlight.home-office.data-v-3ceb4997,
.today-highlight.status-vacation.data-v-3ceb4997,
.today-highlight.status-comp-off.data-v-3ceb4997,
.today-highlight.status-sick.data-v-3ceb4997,
.today-highlight.status-unpaid.data-v-3ceb4997,
.today-highlight.status-public.data-v-3ceb4997 {
  border: 2px solid #1976D2; /* Stronger border for visibility */
}

