/* ===== 礼花 ===== */
.confetti-container.data-v-f29a63c4 {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  z-index: 99;
  overflow: hidden;
}
.confetti-piece.data-v-f29a63c4 {
  position: absolute;
  width: 8px;
  height: 16px;
  top: 100%;
  opacity: 0;
  background-color: var(--bg-color, #ffd300);
}
.confetti-left-anim.data-v-f29a63c4 {
  animation: confetti-left-arc-f29a63c4 var(--duration, 3s) cubic-bezier(0.2, 0.8, 0.4, 1) var(--delay, 0s) forwards;
}
.confetti-right-anim.data-v-f29a63c4 {
  animation: confetti-right-arc-f29a63c4 var(--duration, 3s) cubic-bezier(0.2, 0.8, 0.4, 1) var(--delay, 0s) forwards;
}
@keyframes confetti-left-arc-f29a63c4 {
0% { opacity: 1; top: 90%; left: 0; transform: rotate(0deg);
}
20% { opacity: 1; top: var(--target-y, 10%); left: var(--target-x); transform: rotate(100deg);
}
100% { opacity: 0; top: 110%; left: calc(var(--target-x) + 20%); transform: rotate(var(--rotation));
}
}
@keyframes confetti-right-arc-f29a63c4 {
0% { opacity: 1; top: 90%; left: 100%; transform: rotate(0deg);
}
20% { opacity: 1; top: var(--target-y, 10%); left: var(--target-x); transform: rotate(-100deg);
}
100% { opacity: 0; top: 110%; left: calc(var(--target-x) - 20%); transform: rotate(var(--rotation));
}
}

/* ===== 火箭 ===== */
.rocket-container.data-v-f29a63c4 {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  z-index: 100;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}
.rocket-wrapper.data-v-f29a63c4 {
  position: relative;
  bottom: -100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: rocket-launch-f29a63c4 2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
.rocket-icon.data-v-f29a63c4 {
  font-size: 80px;
  transform: rotate(-45deg);
  filter: drop-shadow(0 10px 10px rgba(0, 0, 0, 0.2));
}
.rocket-trail.data-v-f29a63c4 {
  position: absolute;
  top: 60px;
  width: 20px;
  height: 100px;
}
.trail-spark.data-v-f29a63c4 {
  position: absolute;
  width: 6px;
  height: 6px;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  animation: trail-fall-f29a63c4 0.5s linear infinite;
}
.trail-spark.data-v-f29a63c4:nth-child(1) { left: -5px; animation-delay: 0.1s;
}
.trail-spark.data-v-f29a63c4:nth-child(2) { left: 5px; animation-delay: 0.2s;
}
.trail-spark.data-v-f29a63c4:nth-child(3) { left: 0px; animation-delay: 0s;
}
.trail-spark.data-v-f29a63c4:nth-child(4) { left: -10px; animation-delay: 0.3s;
}
@keyframes rocket-launch-f29a63c4 {
0% { bottom: -100px; transform: scale(0.8);
}
10% { bottom: 20%; transform: scale(1);
}
100% { bottom: 120%; transform: scale(1);
}
}
@keyframes trail-fall-f29a63c4 {
0% { transform: translateY(0) scale(1); opacity: 1;
}
100% { transform: translateY(50px) scale(0); opacity: 0;
}
}

/* ===== 入场动画 ===== */
.anim-entry.data-v-f29a63c4 {
  opacity: 0;
  animation: fadeInUp-f29a63c4 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}
@keyframes fadeInUp-f29a63c4 {
from { opacity: 0; transform: translateY(14px);
}
to { opacity: 1; transform: translateY(0);
}
}
