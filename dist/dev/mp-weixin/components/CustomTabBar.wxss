
/* 设计稿：Tab Bar Area（外层留白）+ 白色圆角胶囊 Bar */
.tab-bar-area.data-v-6def6a3b {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  /* 适配全面屏 Home Indicator：constant() 兜底老 iOS，env() 为标准写法 */
  padding: 12px 21px 12px 21px;
  padding-bottom: calc(12px + constant(safe-area-inset-bottom));
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  z-index: 999;
  pointer-events: none; /* 外层不拦截点击 */
}
.tab-bar.data-v-6def6a3b {
  pointer-events: auto;
  display: flex;
  align-items: stretch;
  gap: 4px;
  height: 62px;
  padding: 4px;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1px solid #E9EBEC;
  border-radius: 36px;
  box-shadow: 0 8px 24px rgba(15, 35, 40, 0.08);
}
.tab-item.data-v-6def6a3b {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  border-radius: 26px;
  transition: background 0.2s ease;
}
.tab-item.active.data-v-6def6a3b {
  background: #0C6D60;
}
.tab-icon-img.data-v-6def6a3b {
  width: 18px;
  height: 18px;
}
.tab-text.data-v-6def6a3b {
  font-size: 10px;
  font-weight: 500;
  color: #9AA1A8;
  line-height: 1.2;
  transition: color 0.2s;
}
.tab-item.active .tab-text.data-v-6def6a3b {
  color: #FFFFFF;
  font-weight: 600;
}
