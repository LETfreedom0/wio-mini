{
  "version": "2.0",
  "envId": "prod-d1glr7pbd4f1ab2f5",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "pay",
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "VIRTUAL_PAY_APPKEY": "{{env.VIRTUAL_PAY_APPKEY}}",
        "WX_APP_SECRET": "{{env.WX_APP_SECRET}}",
        "VIRTUAL_PAY_ITEM_MONTH": "{{env.VIRTUAL_PAY_ITEM_MONTH}}",
        "VIRTUAL_PAY_ITEM_YEAR": "{{env.VIRTUAL_PAY_ITEM_YEAR}}"
      }
    },
    {
      "name": "xpaynotify",
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "paysweep",
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "wxacode",
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "WX_APP_SECRET": "{{env.WX_APP_SECRET}}"
      }
    }
  ]
}
